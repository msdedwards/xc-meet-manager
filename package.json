{
  "name": "xc-meet-manager",
  "version": "0.0.0",
  "private": true,
  "description": "Host your XC meets with ease",
  "repository": "https://github.com/msdedwards/xc-meet-manager",
  "license": "MIT",
  "author": "https://github.com/msdedwards",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "ember build --environment=production",
    "lint": "npm-run-all --aggregate-output --continue-on-error --parallel \"lint:!(fix)\"",
    "lint:fix": "npm-run-all --aggregate-output --continue-on-error --parallel lint:*:fix",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "start": "ember serve",
    "test": "npm-run-all lint test:*",
    "test:ember": "ember test",
    "debug-build": "node --inspect-brk ./node_modules/ember-cli/bin/ember serve"
  },
  "devDependencies": {
    "@ember/optional-features": "^2.0.0",
    "@ember/test-helpers": "^2.6.0",
    "@fortawesome/ember-fontawesome": "^0.2.3",
    "@glimmer/component": "^1.0.4",
    "@glimmer/tracking": "^1.0.4",
    "babel-eslint": "^10.1.0",
    "broccoli-asset-rev": "^3.0.0",
    "ember-auto-import": "^2.2.4",
    "ember-cli": "^4.1.0",
    "ember-cli-app-version": "^5.0.0",
    "ember-cli-babel": "^7.26.11",
    "ember-cli-dependency-checker": "^3.2.0",
    "ember-cli-htmlbars": "^6.0.1",
    "ember-cli-inject-live-reload": "^2.1.0",
    "ember-cli-sass": "^10.0.1",
    "ember-cli-sri": "^2.1.1",
    "ember-cli-terser": "^4.0.2",
    "ember-export-application-global": "^2.0.1",
    "ember-load-initializers": "^2.1.2",
    "ember-modifier": "^3.0.0",
    "ember-maybe-import-regenerator": "^1.0.0",
    "ember-page-title": "^7.0.0",
    "ember-qunit": "^5.1.5",
    "ember-resolver": "^8.0.3",
    "ember-service-worker": "^9.0.1",
    "ember-service-worker-asset-cache": "^0.6.4",
    "ember-service-worker-index": "^0.7.2",
    "ember-source": "~4.2.0-beta.0",
    "ember-template-lint": "^4.0.0",
    "ember-web-app": "^5.0.1",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-ember": "^10.5.8",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-qunit": "^7.2.0",
    "loader.js": "^4.7.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.5.1",
    "qunit": "^2.17.2",
    "qunit-dom": "^2.0.0",
    "sass": "^1.48.0",
    "webpack": "^5.65.0"
  },
  "devDependenciesNotRequiredByDefaultEmberCLIApp": {
    "ember-maybe-import-regenerator": "^1.0.0",
    "ember-functional-modifiers": "^0.5.0",
    "ember-cli-sass": "^10.0.1",
    "ember-cli-eslint": "^5.1.0",
    "ember-cli-bundle-analyzer": "^0.2.2",
    "ember-cli-clipboard": "^0.16.0"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^5.15.4",
    "bulma": "^0.9.3",
    "idb": "^7.0.0",
    "idb-keyval": "^6.1.0",
    "jsbarcode": "^3.11.5",
    "papaparse": "^5.3.1"
  },
  "engines": {
    "node": "12.* || 14.* || >= 16"
  },
  "ember": {
    "edition": "octane"
  }
}