{{#if this.isStreaming}}
    <section class="section video-section">
        <video {{camera-source this.stream}} />
        <div class="video-buttons">
            <button class="button" type="button" {{action "scan" }}>Scan</button>
            <button class="button" type="button" {{action "close" }}>Close Camera</button>
        </div>
    </section>
{{else}}
    <button class="button" type="button" {{action "init" }}>
        Scan
    </button>
{{/if}}