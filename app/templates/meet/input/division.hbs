<h1 class="title">Input Race Results</h1>
<div class="tabs is-fullwidth">
    <ul>
        {{#each this.model.meet.divisions as |division|}}
            <li>
                <LinkTo @route={{this.target.currentPath}} @model={{division}} activeClass="is-active" tagName="li">
                    <a href>Race {{division}}</a>
                </LinkTo>
            </li>
        {{/each}}
    </ul>
</div>
{{outlet}}