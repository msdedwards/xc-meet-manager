<nav class="navbar is-dark no-print" aria-label="main navigation">
    <div class="navbar-brand">
        <LinkTo @route="index" class="navbar-item no-print" activeClass="is-active">
            XC Meet Manager
        </LinkTo>
        <a role="button" href {{action "toggle" }} class="navbar-burger burger {{if this.isActive " is-active"}}"
            aria-label="menu" aria-expanded={{this.isActive}} data-target="main-menu">
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
            <span aria-hidden="true"></span>
        </a>
    </div>
    <div id="main-menu" class="navbar-menu {{if this.isActive " is-active"}}">
        <div class="navbar-start">
            <LinkTo @route="meets" class="navbar-item no-print" activeClass="is-active">
                Meets
            </LinkTo>
            <LinkTo @route="import" class="navbar-item no-print" activeClass="is-active">
                Import a Meet
            </LinkTo>
        </div>
    </div>
</nav>
{{outlet}}
<footer class="footer no-print">
    <div class="content has-text-centered">
        <p>
            <strong>XC Meet Manager</strong> by Matthew Edwards.<br>
            <i>Made with the following technologies:</i>
        </p>
        <a href="https://bulma.io">
            <img src="/made-with-bulma.png" alt="Made with Bulma" width="256" height="48">
        </a>
        <a href="https://emberjs.com">
            <img src="/Ember-Logo.svg" alt="Ember.js">
        </a>
    </div>
</footer>